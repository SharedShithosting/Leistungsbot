sqlite:
  path: "/data/leistungs_db.sqlite"
google: '---Your-API-Key'
bot_token: '1234567:ASDF234567ASDFG'  # YOUR BOT TOKEN HERE GET FROM @BotFather
api_hash: '345678987654323456'  # YOUR API HASH GET FROM my.telegram.org
api_id: '1234567890'  # YOUR API ID GET FROM my.telegram.org
chat_id: '-9876543210'  # YOUR PRIVATE GROUP TO VIEW LOGS OR ERROR
leistungschat_id: '-1234567890'
leistungsadmin_id: '-1234567890'
usernames:
  - 'MyCoolName'  # YOUR USERNAME THIS IS MANDTORY
backupchat_id: "your-backup-channel-id"

# Optional: keep a calendar in step with the leistungstage. Needs a google
# service account whose json key is at `credentials`, and the calendar has
# to be shared with that account's email address ("make changes to events").
# calendar:
#   provider: "google"
#   calendar_id: 'abc123@group.calendar.google.com'
#   credentials: '/data/google-service-account.json'
#   timezone: 'Europe/Vienna'
